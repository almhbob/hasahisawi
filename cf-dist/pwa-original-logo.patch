From d4f832a3ef4abd62687ce791f7fa8d001412101b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 10:53:24 +0000
Subject: [PATCH 1/2] fix(pwa): show the real app icon on the launch screen
 instead of a blurry favicon

The web manifest pointed at /icon.png, but public/icon.png never existed, so
the deploy's `cp ... || true` skipped it silently and Chrome built the PWA
launch screen from the 64px favicon, scaled up and blurred.

- public/icon.png (512), icon-192.png and icon-maskable.png (safe-zone
  padding on the brand background) from assets/images/icon.png
- manifest lists all three with correct sizes and purposes
- favicon regenerated from the same icon
- deploy-web copies the new icons to docs/ and cf-dist/

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SZHqmrmHXxRa1WVz8umkQ1
---
 .github/workflows/deploy-web.yml              |   4 +++
 .../hasahisawi/assets/images/favicon.png      | Bin 5691 -> 5435 bytes
 artifacts/hasahisawi/public/favicon.png       | Bin 0 -> 5435 bytes
 artifacts/hasahisawi/public/icon-192.png      | Bin 0 -> 24655 bytes
 artifacts/hasahisawi/public/icon-maskable.png | Bin 0 -> 63833 bytes
 artifacts/hasahisawi/public/icon.png          | Bin 0 -> 82619 bytes
 artifacts/hasahisawi/public/manifest.json     |  32 +++++++++++++++---
 7 files changed, 32 insertions(+), 4 deletions(-)
 create mode 100644 artifacts/hasahisawi/public/favicon.png
 create mode 100644 artifacts/hasahisawi/public/icon-192.png
 create mode 100644 artifacts/hasahisawi/public/icon-maskable.png
 create mode 100644 artifacts/hasahisawi/public/icon.png

diff --git a/.github/workflows/deploy-web.yml b/.github/workflows/deploy-web.yml
index 0a0349e..1a7bebf 100644
--- a/.github/workflows/deploy-web.yml
+++ b/.github/workflows/deploy-web.yml
@@ -87,6 +87,8 @@ jobs:
           cp artifacts/hasahisawi/public/sw.js docs/sw.js 2>/dev/null || true
           cp artifacts/hasahisawi/public/manifest.json docs/manifest.json 2>/dev/null || true
           cp artifacts/hasahisawi/public/icon.png docs/icon.png 2>/dev/null || true
+          cp artifacts/hasahisawi/public/icon-192.png docs/icon-192.png 2>/dev/null || true
+          cp artifacts/hasahisawi/public/icon-maskable.png docs/icon-maskable.png 2>/dev/null || true
           cp artifacts/hasahisawi/public/favicon.png docs/favicon.png 2>/dev/null || true
           cp docs/index.html docs/404.html
           touch docs/.nojekyll
@@ -187,6 +189,8 @@ jobs:
           cp artifacts/hasahisawi/public/sw.js cf-dist/sw.js 2>/dev/null || true
           cp artifacts/hasahisawi/public/manifest.json cf-dist/manifest.json 2>/dev/null || true
           cp artifacts/hasahisawi/public/icon.png cf-dist/icon.png 2>/dev/null || true
+          cp artifacts/hasahisawi/public/icon-192.png cf-dist/icon-192.png 2>/dev/null || true
+          cp artifacts/hasahisawi/public/icon-maskable.png cf-dist/icon-maskable.png 2>/dev/null || true
           cp artifacts/hasahisawi/public/favicon.png cf-dist/favicon.png 2>/dev/null || true
           cp cf-dist/index.html cf-dist/404.html
           echo '/hasahisawi/* /:splat 302' > cf-dist/_redirects
diff --git a/artifacts/hasahisawi/assets/images/favicon.png b/artifacts/hasahisawi/assets/images/favicon.png
index 0f389cbb4f002a1981870d2866b6b6d6a8906150..9de6fd579d07ed85d6f32f7bfba643b395080121 100644
