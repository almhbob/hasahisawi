  {
   "parameters": {
    "jsCode": "// يختار منشور اليوم من تقويم الحملة (أو اليوم المحدد في test_day للتجربة)\nconst cfg = $('الإعدادات').first().json;\nconst cal = $input.first().json;\nconst tz = cal.timezone || 'Asia/Riyadh';\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: tz }));\nconst today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\nconst [y, m, d] = cal.start_date.split('-').map(Number);\nlet day = Math.round((today - new Date(y, m - 1, d)) / 86400000) + 1;\nif (Number(cfg.test_day) > 0) day = Number(cfg.test_day);\nconst it = (cal.items || []).find(x => x.day === day);\nif (!it) return []; // لا منشور اليوم (قبل البداية أو بعد نهاية الحملة)\nreturn [{ json: {\n  ...cfg, ...it,\n  url: cal.base_url + it.file,\n  ig_url: it.ig_file ? cal.base_url + it.ig_file : '',\n  has_push: !!(it.push && it.push.title),\n} }];"
   },
