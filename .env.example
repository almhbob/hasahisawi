# Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL / Neon / Render managed database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Admin fallback PIN. Change in production.
DEFAULT_ADMIN_PIN=4444

# Firebase Admin SDK service account JSON.
# Keep this as a single-line JSON value in production environment variables.
# Never commit the real value to Git.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk@example.iam.gserviceaccount.com"}

# تعطيل OTP في التسجيل (اضبطه على true عند غياب مزود SMS رسمي)
# القيمة الافتراضية: false — OTP مُفعَّل
EXPO_PUBLIC_DISABLE_OTP=false

# ── مزوّد SMS للـ OTP (Africa's Talking) ──────────────────────────
# أنشئ حساباً على https://africastalking.com لتفعيل إرسال OTP برقم الهاتف
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ── مزوّد البريد الإلكتروني للـ OTP (SMTP) ────────────────────────
# يعمل مع Gmail, Outlook, Sendgrid, Brevo أو أي SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cloudinary (رفع الصور والفيديوهات) ────────────────────────────
# اضبط CLOUDINARY_URL أو الثلاثة أعمدة أدناه
# بدون هذا الإعداد، تُحفظ الملفات في /tmp وتُحذف عند إعادة تشغيل السيرفر
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── اختياري ───────────────────────────────────────────────────────
OPENAI_API_KEY=
RECAPTCHA_SECRET=
VITE_RECAPTCHA_SITE_KEY=
