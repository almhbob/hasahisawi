package {{PACKAGE}}

import android.app.Activity
import android.app.Notification
import android.app.NotificationManager
import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Build
import android.provider.Settings
import android.view.WindowManager
import com.facebook.react.ReactPackage
import com.facebook.react.bridge.NativeModule
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod
import com.facebook.react.uimanager.ViewManager

/**
 * المكالمة الواردة بملء الشاشة:
 * - إظهار النشاط فوق قفل الشاشة وإضاءتها (فقط أثناء شاشة المكالمة)
 * - التحقق من إذن «الإشعارات بملء الشاشة» في Android 14+ وفتح إعداداته
 */
object CallWindow {
  fun apply(activity: Activity, overLockScreen: Boolean, keepScreenOn: Boolean) {
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
      activity.setShowWhenLocked(overLockScreen)
      activity.setTurnScreenOn(overLockScreen)
    } else {
      @Suppress("DEPRECATION")
      val flags = WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED or WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON
      if (overLockScreen) activity.window.addFlags(flags) else activity.window.clearFlags(flags)
    }
    val keep = WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
    if (keepScreenOn) activity.window.addFlags(keep) else activity.window.clearFlags(keep)
  }

  /**
   * هل فُتح النشاط من إشعار مكالمة واردة (نيّة ملء الشاشة أو زر «رد» من Notifee)؟
   * نتحقق أيضاً من وجود إشعار مكالمة معروض فعلاً من تطبيقنا، حتى لا تستطيع نيّة
   * خارجية مزيّفة إظهار التطبيق فوق قفل الشاشة.
   */
  fun isIncomingCallLaunch(activity: Activity, intent: Intent?): Boolean {
    return try {
      val n = intent?.getBundleExtra("notification") ?: return false
      if (n.getBundle("data")?.getString("type") != "call") return false
      if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) return true
      val nm = activity.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
      nm.activeNotifications.any { it.notification.category == Notification.CATEGORY_CALL }
    } catch (e: Exception) {
      false
    }
  }

  fun onActivityIntent(activity: Activity, intent: Intent?) {
    try {
      if (isIncomingCallLaunch(activity, intent)) apply(activity, true, true)
    } catch (_: Exception) {}
  }
}

class CallScreenModule(reactContext: ReactApplicationContext) : ReactContextBaseJavaModule(reactContext) {
  override fun getName(): String = "HasahisawiCallScreen"

  @ReactMethod
  fun setCallWindow(overLockScreen: Boolean, keepScreenOn: Boolean) {
    val activity = reactApplicationContext.currentActivity ?: return
    activity.runOnUiThread {
      try { CallWindow.apply(activity, overLockScreen, keepScreenOn) } catch (_: Exception) {}
    }
  }

  @ReactMethod
  fun canUseFullScreenIntent(promise: Promise) {
    try {
      if (Build.VERSION.SDK_INT < 34) { promise.resolve(true); return }
      val nm = reactApplicationContext.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
      promise.resolve(nm.canUseFullScreenIntent())
    } catch (e: Exception) {
      promise.resolve(true)
    }
  }

  @ReactMethod
  fun openFullScreenIntentSettings(promise: Promise) {
    val ctx = reactApplicationContext
    val pkg = ctx.packageName
    val intents = mutableListOf<Intent>()
    if (Build.VERSION.SDK_INT >= 34) {
      intents.add(Intent("android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENT", Uri.parse("package:$pkg")))
    }
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
      intents.add(Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS).putExtra(Settings.EXTRA_APP_PACKAGE, pkg))
    }
    intents.add(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:$pkg")))
    for (i in intents) {
      try {
        i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        ctx.startActivity(i)
        promise.resolve(true)
        return
      } catch (_: Exception) {}
    }
    promise.resolve(false)
  }
}

class CallScreenPackage : ReactPackage {
  @Suppress("OVERRIDE_DEPRECATION", "DEPRECATION")
  override fun createNativeModules(reactContext: ReactApplicationContext): List<NativeModule> =
      listOf(CallScreenModule(reactContext))

  override fun createViewManagers(reactContext: ReactApplicationContext): List<ViewManager<in Nothing, in Nothing>> =
      emptyList()
}
