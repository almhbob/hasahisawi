{
  "expo": {
    "name": "حصاحيصاوي",
    "slug": "al-hasahisa-service",
    "version": "6.5.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hasahisawi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/city-crest.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almhbob.hasahisawi",
      "buildNumber": "256",
      "infoPlist": {
        "NSCameraUsageDescription": "التطبيق يحتاج إذناً للكاميرا لالتقاط صورة شخصية",
        "NSPhotoLibraryUsageDescription": "التطبيق يحتاج إذناً للوصول إلى الصور لتغيير الصورة الشخصية",
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لإرسال موقع الحادثة مع البلاغ",
        "NSFaceIDUsageDescription": "التطبيق يستخدم معرف الوجه لتسجيل الدخول بأمان",
        "NSMicrophoneUsageDescription": "التطبيق يحتاج إذناً للميكروفون لتسجيل مقاطع الصوت",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.133656291161-kajn1h6a40oriel45qsb4douvl8apm5e"
        }
      }
    },
    "android": {
      "package": "com.almhbob.hasahisawi",
      "versionCode": 256,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "حصاحيصاوي",
      "shortName": "حصاحيصاوي",
      "description": "بوابتك المجتمعية لمدينة الحصاحيصا وقراها",
      "themeColor": "#009B67",
      "backgroundColor": "#F7FFF9",
      "lang": "ar",
      "dir": "rtl",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يستخدم التطبيق موقعك لإرسال موقع الحادثة مع البلاغ",
          "locationWhenInUsePermission": "يستخدم التطبيق موقعك لإرسال موقع الحادثة مع البلاغ"
        }
      ],
      "./plugins/withResizeableActivity",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "التطبيق يستخدم معرف الوجه لتسجيل الدخول بأمان"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "التطبيق يحتاج إذناً للوصول إلى الصور لتغيير الصورة الشخصية",
          "cameraPermission": "التطبيق يحتاج إذناً للكاميرا لالتقاط صورة شخصية"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#009B67",
          "defaultChannel": "hasahisawi-default",
          "sounds": [
            "./assets/sounds/hasahisawi_notif.wav",
            "./assets/sounds/hasahisawi_chat.wav",
            "./assets/sounds/hasahisawi_urgent.wav",
            "./assets/sounds/hasahisawi_prayer.wav"
          ],
          "androidChannels": [
            {
              "name": "حصاحيصاوي — تنبيهات عامة",
              "importance": 3,
              "sound": "hasahisawi_notif",
              "vibrationPattern": [
                0,
                200,
                100,
                200
              ],
              "lightColor": "#009B67",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": false,
              "lockscreenVisibility": 1
            },
            {
              "name": "حصاحيصاوي — رسائل",
              "importance": 4,
              "sound": "hasahisawi_chat",
              "vibrationPattern": [
                0,
                100,
                80,
                100,
                80,
                100
              ],
              "lightColor": "#009B67",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": false,
              "lockscreenVisibility": 0
            },
            {
              "name": "حصاحيصاوي — تنبيهات عاجلة",
              "importance": 5,
              "sound": "hasahisawi_urgent",
              "vibrationPattern": [
                0,
                600,
                200,
                600,
                200,
                600
              ],
              "lightColor": "#FFC20A",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": true,
              "lockscreenVisibility": 1
            },
            {
              "name": "حصاحيصاوي — تحديثات السفر",
              "importance": 4,
              "sound": "hasahisawi_notif",
              "vibrationPattern": [
                0,
                300,
                150,
                300
              ],
              "lightColor": "#009B67",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": false,
              "lockscreenVisibility": 1
            },
            {
              "name": "حصاحيصاوي — أوقات الصلاة",
              "importance": 4,
              "sound": "hasahisawi_prayer",
              "vibrationPattern": [
                0,
                400,
                100,
                400
              ],
              "lightColor": "#FFC20A",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": false,
              "bypassDnd": false,
              "lockscreenVisibility": 1
            }
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "التطبيق يستخدم الكاميرا لمسح رمز QR لتسجيل الدخول على الكمبيوتر",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": ""
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d3b27d0-5d06-49dd-9b21-be26fb7a5a1a"
      },
      "privacyPolicyUrl": "https://almhbob.github.io/hasahisawi/privacy.html",
      "deleteAccountUrl": "https://almhbob.github.io/hasahisawi/delete-account.html"
    },
    "owner": "almhbob2026"
  }
}
