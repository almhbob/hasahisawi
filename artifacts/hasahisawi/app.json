{
  "expo": {
    "name": "حصاحيصاوي",
    "slug": "al-hasahisa-service",
    "version": "6.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hasahisawi",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/city-crest.png",
      "resizeMode": "cover",
      "backgroundColor": "#F2EBD8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almhbob.hasahisawi",
      "buildNumber": "223",
      "infoPlist": {
        "NSCameraUsageDescription": "التطبيق يحتاج إذناً للكاميرا لالتقاط صورة شخصية",
        "NSPhotoLibraryUsageDescription": "التطبيق يحتاج إذناً للوصول إلى الصور لتغيير الصورة الشخصية",
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لإرسال موقع الحادثة مع البلاغ",
        "NSFaceIDUsageDescription": "التطبيق يستخدم معرف الوجه لتسجيل الدخول بأمان",
        "NSMicrophoneUsageDescription": "التطبيق يحتاج إذناً للميكروفون لتسجيل مقاطع الصوت",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.133656291161-kajn1h6a40oriel45qsb4douvl8apm5e"
        }
      }
    },
    "android": {
      "package": "com.almhbob.hasahisawi",
      "versionCode": 223,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "حصاحيصاوي",
      "shortName": "حصاحيصاوي",
      "description": "بوابتك المجتمعية لمدينة الحصاحيصا وقراها",
      "themeColor": "#27AE68",
      "backgroundColor": "#0D0D0D",
      "lang": "ar",
      "dir": "rtl",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يستخدم التطبيق موقعك لإرسال موقع الحادثة مع البلاغ",
          "locationWhenInUsePermission": "يستخدم التطبيق موقعك لإرسال موقع الحادثة مع البلاغ"
        }
      ],
      "./plugins/withResizeableActivity",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "التطبيق يستخدم معرف الوجه لتسجيل الدخول بأمان"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "التطبيق يحتاج إذناً للوصول إلى الصور لتغيير الصورة الشخصية",
          "cameraPermission": "التطبيق يحتاج إذناً للكاميرا لالتقاط صورة شخصية"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#27AE68",
          "defaultChannel": "hasahisawi-default",
          "androidChannels": [
            {
              "name": "حصاحيصاوي — تنبيهات عامة",
              "importance": 3,
              "vibrationPattern": [0, 200, 100, 200],
              "lightColor": "#27AE68",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": false,
              "lockscreenVisibility": 1
            },
            {
              "name": "حصاحيصاوي — رسائل",
              "importance": 4,
              "vibrationPattern": [0, 100, 80, 100, 80, 100],
              "lightColor": "#3B82F6",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": false,
              "lockscreenVisibility": 0
            },
            {
              "name": "حصاحيصاوي — تنبيهات عاجلة",
              "importance": 5,
              "vibrationPattern": [0, 600, 200, 600, 200, 600],
              "lightColor": "#EF4444",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": true,
              "lockscreenVisibility": 1
            },
            {
              "name": "حصاحيصاوي — تحديثات السفر",
              "importance": 4,
              "vibrationPattern": [0, 300, 150, 300],
              "lightColor": "#0EA5E9",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": true,
              "bypassDnd": false,
              "lockscreenVisibility": 1
            },
            {
              "name": "حصاحيصاوي — أوقات الصلاة",
              "importance": 4,
              "vibrationPattern": [0, 400, 100, 400],
              "lightColor": "#F59E0B",
              "enableLights": true,
              "enableVibrate": true,
              "showBadge": false,
              "bypassDnd": false,
              "lockscreenVisibility": 1
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d3b27d0-5d06-49dd-9b21-be26fb7a5a1a"
      }
    },
    "owner": "almhbob2026"
  }
}
