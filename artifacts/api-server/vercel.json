{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "ignoreCommand": "exit 0",
  "buildCommand": "node build.mjs",
  "installCommand": "corepack enable && corepack prepare pnpm@10 --activate && pnpm install --no-frozen-lockfile",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "dist/**",
          "public/member-card/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
